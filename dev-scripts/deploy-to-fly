#!/usr/bin/env bash

# Deploy a Nix-built image to the app configured in fly.toml.
set -euo pipefail

if [[ "$#" -ne 1 ]]; then
  printf 'Usage: %s SKOPEO_POLICY\n' "$0" >&2
  exit 2
fi
: "${FLY_API_TOKEN:?FLY_API_TOKEN must be set}"

app=''
readonly policy="$1"

while IFS= read -r line; do
  if [[ "${line}" =~ ^app[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
    app="${BASH_REMATCH[1]}"
    break
  fi
done < fly.toml
if [[ -z "${app}" ]]; then
  printf 'Could not determine the Fly app name from fly.toml.\n' >&2
  exit 1
fi
tag="$(git rev-parse --short HEAD)"
readonly app tag
readonly image="registry.fly.io/${app}:deployment-${tag}"

archive="$(mktemp --suffix=.tar)"
auth_home="$(mktemp --directory)"
readonly archive auth_home
trap 'rm --force "${archive}"; rm --recursive --force "${auth_home}"' EXIT

stream-docker-image > "${archive}"

# Restrict PATH so Fly writes credentials instead of invoking a Docker CLI.
fly_bin="$(dirname "$(command -v fly)")"
readonly fly_bin
HOME="${auth_home}" PATH="${fly_bin}" fly auth docker

skopeo --policy "${policy}" copy \
  --dest-authfile "${auth_home}/.docker/config.json" \
  "docker-archive:${archive}" "docker://${image}"

fly deploy --app "${app}" --image "${image}" --ha=false
