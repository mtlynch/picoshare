#!/usr/bin/env bash

# Package the three release binaries into gzip-compressed archives.
set -euo pipefail

if [[ $# -ne 3 ]]; then
  printf 'Usage: %s VERSION BINARIES_DIR OUTPUT_DIR\n' "$0" >&2
  exit 2
fi

version=$1
binaries=$2
output=$3
mkdir --parents "$output"

for arch in amd64 arm64 armv7; do
  tar --create --gzip --file="$output/picoshare-v$version-linux-$arch.tar.gz" \
    --directory="$binaries/linux-$arch" picoshare
done
